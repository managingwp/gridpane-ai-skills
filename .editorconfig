# EditorConfig: https://editorconfig.org
# See PLAN.md (Phase 0) and AGENTS.md (Writing style).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,markdown}]
indent_style = space
indent_size = 2

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 4

[*.{json}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
