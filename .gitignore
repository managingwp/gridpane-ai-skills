# .gitignore

# Local environment and secrets
.env
.env.*
!.env.example

# Backups created before editing config files (see safety model)
*.bak-*
*.orig

# Generated output
out/

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp

tmp/
/plans

# Playwright MCP workspace artifacts
.playwright-mcp/
